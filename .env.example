# ============================================================
# Frontend (Expo Web + WebView shell)
# Hanya variabel EXPO_PUBLIC_* yang ikut ter-bundle ke browser.
# JANGAN menaruh service role key di sini.
# ============================================================

# URL backend API saat development.
# Kosongkan untuk production agar frontend memakai origin yang sama.
EXPO_PUBLIC_API_URL=http://localhost:4000

# URL web yang dibuka oleh aplikasi Android/iOS (WebView).
# Isi dengan URL hasil deploy, contoh: https://absensi.example.com
EXPO_PUBLIC_WEBVIEW_URL=
