{
  "expo": {
    "name": "Absensi Karyawan",
    "slug": "mobile-rn-user",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "absensi",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.absensi.user",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Lokasi dipakai untuk memvalidasi radius absensi.",
        "NSCameraUsageDescription": "Kamera dipakai untuk kebutuhan absensi."
      }
    },
    "android": {
      "package": "com.absensi.user",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B1220"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Izinkan $(PROJECT_NAME) untuk mengakses kamera?"
        }
      ],
      "expo-image-picker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Izinkan $(PROJECT_NAME) mengakses lokasi untuk absensi?"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0B1220"
        }
      ]
    ]
  }
}
