# ============================================================
# Backend API - Absensi
# Copy file ini menjadi .env lalu isi nilainya.
# JANGAN commit .env ke Git.
# ============================================================

PORT=4000

# Supabase (Settings > API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Origin web yang diizinkan (pisahkan dengan koma).
# Kosongkan untuk mengizinkan semua origin (API memakai Bearer token, bukan cookie).
WEB_ORIGINS=http://localhost:8081,http://localhost:19006

# Titik kantor untuk validasi geofence
OFFICE_NAME=Kantor Pusat
OFFICE_LAT=-7.988931
OFFICE_LNG=112.627671
OFFICE_RADIUS_M=150

# Jika 1, absensi ditolak ketika GPS tidak tersedia / di luar radius.
# Jika 0, absensi tetap dicatat dengan lokasi_tidak_tersedia=true.
REQUIRE_LOCATION=0

# Jika 1, absensi di luar radius kantor ditolak.
# Set 0 hanya untuk demo di lokasi lain.
ENFORCE_GEOFENCE=1

# Toleransi galat GPS: posisi yang sedikit di luar radius masih diterima
# selama akurasi GPS-nya menjelaskan selisih tersebut (meter).
GEOFENCE_ACCURACY_MARGIN_M=25

# Akurasi GPS terburuk yang masih diterima (meter). Lebih buruk dari ini,
# absensi ditolak dengan pesan agar menunggu sinyal membaik.
MAX_ACCURACY_M=50

# Foto selfie absensi, disimpan di bucket Supabase Storage 'employee-photos'.
# REQUIRE_PHOTO=1 membuat absensi tanpa foto ditolak.
REQUIRE_PHOTO=0
MAX_PHOTO_MB=3

# Jam kerja (WIB) untuk menghitung status Terlambat
WORK_START=07:00
WORK_END=17:00
LATE_TOLERANCE_MIN=15

# ============================================================
# Face recognition + liveness
# ============================================================
# Threshold jarak EUCLIDEAN descriptor face-api (bukan cosine!).
# Beda orang hasil ukur: 0.52-0.89. Semakin kecil = semakin ketat.
FACE_VERIFY_THRESHOLD=0.45
FACE_DUPLICATE_THRESHOLD=0.35

# Setelah 3 kegagalan liveness dalam sehari, absen wajah diblokir sampai
# admin melakukan reset wajah. 0 = nonaktif.
FACE_MAX_FAILS_PER_DAY=3
FACE_VERIFY_PER_MINUTE=5

# Batas ukuran satu foto wajah & body request /api/face.
# 3 foto x 4MB base64 ~ 16MB, jadi limit face route terpisah dari global 1mb.
MAX_FACE_PHOTO_MB=4
FACE_BODY_LIMIT=16mb

# Ambang kualitas foto (0-255). Kalibrasi ulang dengan kamera asli.
FACE_MIN_BRIGHTNESS=45
FACE_MAX_BRIGHTNESS=215
FACE_MIN_SHARPNESS=15
FACE_MIN_CONTRAST=18

# Reverse geocoding alamat (OpenStreetMap Nominatim). Set 0 untuk mematikan.
GEOCODE_ENABLED=1
